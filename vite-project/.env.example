# Backend API Server URL (leave empty or set to http://localhost:5000 in dev, or your deployed Render/Railway URL)
VITE_BACKEND_URL=http://localhost:5000

# Direct Supabase Configuration (optional if using backend)
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
