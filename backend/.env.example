# SwarSetu Backend Environment Variables
PORT=5000
NODE_ENV=development

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is optional but bypasses RLS for server-to-server operations if needed:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend URL for CORS (comma-separated if multiple, e.g. for production deployment)
CLIENT_URL=http://localhost:5173,http://localhost:5174
